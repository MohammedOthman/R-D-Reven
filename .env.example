# Copy this file to .env at the repo root and adjust values for your machine.
# Individual apps read these through process.env; apps/web and apps/api also
# accept an app-local .env for values that must never be shared (see their
# own .env.example files).

# --- Database (packages/db, apps/api) ---
# Local Postgres started via `docker compose up -d`, or Homebrew's postgresql@16.
DATABASE_URL="postgresql://revn:revn@localhost:5432/revn_dev?schema=public"

# --- API (apps/api) ---
API_PORT=4000
NODE_ENV=development
# Generate your own for local dev: `openssl rand -base64 48`. Never reuse a
# checked-in value in a real environment.
JWT_ACCESS_SECRET="dev-only-secret-change-me-dev-only-secret-change-me"
# Left unset in development (host-only cookie is fine on localhost). Set to
# ".yourdomain.com" in production so the auth cookie is shared with the web
# app's subdomain.
COOKIE_DOMAIN=
WEB_ORIGIN="http://localhost:3000"
# Transactional email (password reset, invitations). Leave all three unset
# locally: the API logs each link instead of sending it. Set all three in
# production, e.g. MAIL_API_URL="https://api.resend.com/emails".
# MAIL_API_URL=
# MAIL_API_KEY=
# MAIL_FROM="Reven <no-reply@yourdomain.com>"

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
